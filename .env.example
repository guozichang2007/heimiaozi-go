# ============ 必填 ============
# DeepSeek API Key（在 https://platform.deepseek.com 申请）。留空则黑喵子离线，仅用模板台词。
DEEPSEEK_API_KEY=

# ============ 可选 ============
# 黑喵子使用的 DeepSeek 模型（v4-flash 便宜快；v4-pro 更聪明但稍贵稍慢）
DEEPSEEK_MODEL=deepseek-v4-flash

# 围棋引擎后端：opencl（默认，驱动自带即可用）或 cuda（需自行安装 CUDA 工具包 + cuDNN）
# 切换为 cuda 前请先运行 server/data/setup-engines.ps1 完成配置检查
KATAGO_BACKEND=opencl

# 引擎可执行文件与网络模型路径（留 auto 自动在 server/data 下查找）
KATAGO_BINARY=auto
KATAGO_MODEL=auto

# 服务器端口
PORT=5177

# ============ 隐藏功能：玩家胜率大跌时的郊狼电击（默认关闭） ============
# 开启后：玩家落子后，玩家方胜率较上一次落子时下跌 ≥8% 即触发一次电击（不影响网页端任何功能/显示）
# 通道：Buttplug.io / Intiface（需先安装 Intiface Central 并配对郊狼设备，然后 SHOCK_ENABLED=true）
SHOCK_ENABLED=false
# 电击强度倍率 0~1（在"跌幅映射强度"基础上再乘此值）
SHOCK_INTENSITY=0.6
# 每次电击持续时间（毫秒）
SHOCK_DURATION_MS=1200
# Intiface WebSocket 地址
SHOCK_WS_URL=ws://127.0.0.1:12345
